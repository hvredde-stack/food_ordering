# ─── Supabase ────────────────────────────────────────────────
# Project URL and publishable/anon key are public; secret keys are private.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_eyJhbGciOi...

# Supabase Storage bucket for dish images. Create it once in the dashboard
# (Storage → New bucket → name: dish-images, public: ON).
SUPABASE_STORAGE_BUCKET=dish-images

# ─── Clerk (admin portal only) ───────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# ─── Session ─────────────────────────────────────────────────
# 30 minutes in seconds.
CUSTOMER_SESSION_TTL_SECONDS=1800

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
